{
  "name": "flutter_copilot_cli",
  "version": "1.0.5",
  "description": "TypeScript CLI for driving Flutter apps via flutter_copilot_claw VM service extensions.",
  "type": "module",
  "bin": {
    "flutter_copilot_cli": "./dist/index.js",
    "fcc": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "flutter",
    "flutter-copilot",
    "vm-service",
    "cli",
    "automation",
    "smoke-test",
    "mcp",
    "ai"
  ],
  "homepage": "https://github.com/dust365/flutter_copilot/tree/main/packages/flutter_copilot_cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dust365/flutter_copilot.git",
    "directory": "packages/flutter_copilot_cli"
  },
  "bugs": {
    "url": "https://github.com/dust365/flutter_copilot/issues"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm clean && pnpm build && pnpm test"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "ws": "^8.18.0",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
